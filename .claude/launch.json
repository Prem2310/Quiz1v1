{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "quizit",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "quizit", "run", "dev"],
      "port": 3000,
      "autoPort": true,
      "env": {
        "BASE_PATH": "/",
        "VITE_API_BASE_URL": "http://localhost:8000"
      }
    },
    {
      "name": "api-server",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "api-server", "run", "dev"],
      "port": 8000
    },
    {
      "name": "api-server-8001",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "api-server", "exec", "python", "-m", "uvicorn", "app.main:app", "--host", "127.0.0.1", "--port", "8001"],
      "port": 8001
    }
  ]
}
