# Copy to .env (git-ignored) and fill in. Only what you set is used; everything has a local default.

# Database: SQLite locally by default. Set the Supabase/PostgreSQL URL for production.
# DATABASE_URL=
# SUPABASE_DATABASE_URL=

JWT_SECRET=
# REDIS_URL=
CORS_ORIGINS=https://quiz1v1.tech,https://www.quiz1v1.tech

# --- Google / GitHub sign-in (a button appears only when its id AND secret are set) ---
# Callback URL to register with each provider:
#   http://localhost:8000/api/auth/oauth/google/callback   (and .../github/callback)
#   https://<your-api-host>/api/auth/oauth/google/callback (and .../github/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Where the browser lands after sign-in: the URL people actually open the site at, exactly.
FRONTEND_URL=http://localhost:5173
# This API's public origin (https in production, as registered with the providers).
# API_PUBLIC_URL=http://localhost:8000
